[Unit]
Description=MonitorShift sleep button (GPIO3)
After=multi-user.target

[Service]
User=pi
Group=pi
SupplementaryGroups=gpio
Environment=GPIOZERO_PIN_FACTORY=lgpio
WorkingDirectory=/home/pi
ExecStart=/usr/bin/python3 /home/pi/tlacitko.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
